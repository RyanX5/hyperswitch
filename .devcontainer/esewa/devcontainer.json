// Dev environment for building the eSewa connector. Not part of the upstream PR.
// Dependencies (Postgres, Redis, Superposition, migrations) run in Docker via
// docker-compose-development.yml; the router itself is built natively with cargo.
{
  "name": "hyperswitch-esewa",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // Keep the debug build small: line tables only, mold for linking, 4 parallel rustc.
  "containerEnv": {
    "CARGO_INCREMENTAL": "1",
    "CARGO_BUILD_JOBS": "4",
    "CARGO_PROFILE_DEV_DEBUG": "line-tables-only",
    "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=mold"
  },
  "postCreateCommand": "bash .devcontainer/esewa/setup.sh",
  "postStartCommand": "bash .devcontainer/esewa/deps-up.sh",
  "forwardPorts": [8080, 8081],
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tamasfe.even-better-toml"],
      // rust-analyzer would compete with cargo for RAM; index on demand only.
      "settings": {
        "rust-analyzer.cachePriming.enable": false,
        "rust-analyzer.checkOnSave": false
      }
    }
  }
}
